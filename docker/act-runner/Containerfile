# act runner on top of the buildroot image (localhost/shiranekowrt-builder:base,
# built from docker/builder-base/Containerfile in this repo):
# keeps the full OpenWrt host toolchain preinstalled, adds what act and the
# workflows need that the base lacks (node for JS actions, curl, jq, shellcheck,
# yamllint, passwordless sudo for the workflow's apt step, lsb_release, gh for release jobs).
FROM localhost/shiranekowrt-builder:base

USER root

RUN apt-get update \
    && apt-get install --no-install-recommends --no-install-suggests --yes \
        curl ca-certificates gnupg jq shellcheck yamllint sudo lsb-release \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install --no-install-recommends --no-install-suggests --yes nodejs \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install --no-install-recommends --no-install-suggests --yes gh \
    && rm -f -r /var/lib/apt/ /var/cache/apt/ \
    && echo "buildbot ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/buildbot \
    && chmod 0440 /etc/sudoers.d/buildbot

# Local-run convenience: act mounts the repo's .local-mirrors/ directory at /mnt/git-mirrors
# (see .actrc --container-options). The system gitconfig below transparently redirects the
# multi-GB upstream OpenWrt clone to the local mirror so local runs survive a flaky
# github link. On GitHub-hosted runners this image is not used; workflows are unchanged.
RUN git config --system url."file:///mnt/git-mirrors/openwrt-nss-edma".insteadOf "https://github.com/JuliusBairaktaris/openwrt-nss-edma"

USER buildbot
